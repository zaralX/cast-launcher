{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cast-launcher",
  "version": "1.6.0",
  "identifier": "cast-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cast Launcher",
        "width": 1080,
        "height": 620,
        "minWidth": 1080,
        "minHeight": 620,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "zaralX",
    "homepage": "https://github.com/zaralX/cast-launcher",
    "copyright": "Copyright © 2026 zaralX",
    "license": "Apache-2.0",
    "category": "Game",
    "shortDescription": "Minecraft launcher and modpack manager",
    "longDescription": "Cast Launcher installs and runs Minecraft, manages instances and modpacks from Modrinth and CurseForge, and keeps them up to date.",
    "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public"
    ],
    "fileAssociations": [
      {
        "ext": ["cast"],
        "name": "Cast Pack",
        "description": "Cast Launcher modpack",
        "role": "Viewer",
        "mimeType": "application/x-cast-pack",
        "contentTypes": ["ru.zaralx.castlauncher.pack"],
        "exportedType": {
          "identifier": "ru.zaralx.castlauncher.pack",
          "conformsTo": ["public.data", "public.zip-archive"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMUFCN0IwMkI1OTFFNUIKUldSYkhsa3JzTGNhZ29zR1U3NERLUFFLcldFY3NnYkV2bUJFRnQ5WU9ZZEZ2NGNVOE9CTmpwT2QK",
      "endpoints": [
        "https://github.com/zaralX/cast-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
