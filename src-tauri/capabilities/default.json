{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права главного окна. Файловая система, сеть и запуск процессов фронту недоступны: всё это делают команды в Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close"
  ]
}
